# Using Docker Hardened Image for improved security
# The -dev variant includes shell and package manager needed for scripts
FROM dhi.io/node:20-alpine3.22-dev

WORKDIR /app

# Install curl for health checks and API calls
RUN apk add --no-cache curl

# Copy package files and install dependencies
COPY package*.json ./
RUN npm ci --only=production

# Copy setup scripts and validation rules
COPY couchLoader.js ./
COPY index.js ./
COPY config.js ./
COPY validators/ ./validators/
COPY utils/ ./utils/

# Copy initialization script
COPY scripts/docker-init.sh ./
RUN chmod +x docker-init.sh

CMD ["./docker-init.sh"]